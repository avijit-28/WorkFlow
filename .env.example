# Copy to .env for local development. On Railway, set these as
# Variables in the service settings instead of using this file.

SECRET_KEY=change-this-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Leave unset locally to use SQLite. Railway's Postgres plugin
# injects DATABASE_URL automatically -- you don't need to set it
# yourself in production.
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# Comma-separated list of allowed frontend origins for CORS.
# Leave unset to allow all origins (fine for API testing/dev).
# CORS_ALLOWED_ORIGINS=https://your-frontend.example.com

# Private code required to self-register as an admin via the signup
# form's optional "admin invite code" field. Keep this secret and only
# share it with people who should be able to create admin accounts.
# Leave unset/blank to disable self-service admin signup entirely --
# then admins can only be created via `manage.py createsuperuser`,
# `manage.py promote_admin <username>`, or the Django admin panel.
ADMIN_SIGNUP_CODE=

# Email (used for password-reset links). Defaults to printing emails
# to the server console -- fine for local dev, nothing to configure.
# For real emails in production, set:
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.yourprovider.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=you@yourdomain.com
# EMAIL_HOST_PASSWORD=your-smtp-password
# EMAIL_USE_TLS=True
# DEFAULT_FROM_EMAIL=noreply@yourdomain.com
